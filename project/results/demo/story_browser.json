 "pass": true,
 "steps": [
  {
   "n": 1,
   "say_en": "Ana posts in sub A. Posts carry no author name: on the other screens it is just a post.",
   "pass": true,
   "check": "held",
   "arrival_s": {
    "0": 0.03,
    "1": 0.04,
    "2": 0.06,
    "3": 0.06,
    "4": 0.07
   }
  },
  {
   "n": 2,
   "say_en": "Cho searches 'cycling to school'. Cho's own box searches its own index (no server).",
   "pass": true,
   "check": "search",
   "top": [
    "Bike lanes on Mill Ave are finally open"
   ]
  },
  {
   "n": 3,
   "say_en": "Ana posts in sub B. Only the boxes holding sub B (Ana, Cho, Eve) get it; Ben's and Dev's never do.",
   "pass": true,
   "check": "held",
   "arrival_s": {
    "0": 0.0,
    "2": 0.01,
    "4": 0.01
   },
   "held_where_it_should_not": []
  },
  {
   "n": 4,
   "say_en": "Ben writes in room R. Only Ana, Ben and Dev (told the password) can read it. Cho's and Eve's boxes carry the encrypted envelope and cannot open it.",
   "pass": true,
   "check": "room",
   "readers_s": 0.04,
   "relays": {
    "2": {
     "holds_envelope": true,
     "member": false
    },
    "4": {
     "holds_envelope": true,
     "member": false
    }
   }
  },
  {
   "n": 5,
   "say_en": "Dev closes the laptop. Box 3 goes off (no goodbye: the process is killed).",
   "pass": true,
   "check": "down"
  },
  {
   "n": 6,
   "say_en": "While Dev is away, Cho posts a photo (a COCO picture). The four boxes that are on get it.",
   "pass": true,
   "check": "held",
   "arrival_s": {
    "0": 0.0,
    "1": 0.02,
    "2": 0.03,
    "4": 0.03
   }
  },
  {
   "n": 7,
   "say_en": "Ben upvotes the photo. A vote is a message too: every box that is on counts the score itself.",
   "pass": true,
   "check": "score",
   "seconds": 0.07
  },
  {
   "n": 8,
   "say_en": "Dev opens the laptop. As soon as box 3 is on it reconciles with its neighbours and gets the missed photo post and vote.",
   "pass": true,
   "check": "caught",
   "seconds_after_box_answered": 0.0,
   "box_start_s": 2.1,
   "recon": {
    "recon_sessions": 4,
    "recon_fetched": 0,
    "recon_bytes": 1320,
    "offer_want": 2
   }
  },
  {
   "n": 9,
   "say_en": "Ana deletes the first post. All five boxes drop the original and remember its id so it never comes back (forgetting).",
   "pass": true,
   "check": "gone",
   "seconds": 0.01
  },
  {
   "n": 10,
   "say_en": "Eve tries to delete Cho's photo. There is no delete button on someone else's post, and asking the box directly is refused (no author key). With no operator, nobody can delete someone else's post.",
   "pass": true,
   "check": "refused",
   "status": 403,
   "error": "only the author holds this post's key",
   "still_held_on": [
    0,
    1,
    2,
    3,
    4
   ]
  },
  {
   "n": 11,
   "say_en": "The network splits: {Ana, Ben} | {Cho, Dev, Eve}. One person on each side posts. Nothing crosses.",
   "pass": true,
   "check": "split",
   "p11a": {
    "arrival_s": {
     "0": 0.0,
     "1": 0.0
    },
    "crossed_to": []
   },
   "p11b": {
    "arrival_s": {
     "2": 0.0,
     "3": 0.01,
     "4": 0.01
    },
    "crossed_to": []
   }
  },
  {
   "n": 12,
   "say_en": "The network heals. Nobody announces it; the boxes meet again and exchange only what the other lacks.",
   "pass": true,
   "check": "held_all",
   "seconds": 7.5
  },
  {
   "n": 13,
   "say_en": "An attacker: while Ben's box is cut off, Dev posts, and the attacker hands Ben's box a forged copy first (same id, other content). Ben's box refuses it (the id is not the content's hash) and gets the real one when the links come back.",
   "pass": true,
   "check": "forged",
   "held_forged": false,
   "rej_id_delta": 1,
   "real_after_heal_s": 5.09
  },
  {
   "n": 14,
   "say_en": "Eve breaks the limit: two posts on the same message index. Any box holding both can compute Eve's identity secret and publish it, and every box removes Eve from the group. Not an operator's ban: math.",
   "pass": true,
   "check": "slashed",
   "seconds": 0.05,
   "offender_sees_slashed": true
  },
  {
   "n": 15,
   "say_en": "Eve posts again. The other four boxes drop it: the proof no longer verifies.",
   "pass": true,
   "check": "dropped",
